Screen {
    layout: vertical;
}

#dashboard-summary,
#status-content,
#preview-content,
#doctor-content,
#removals-summary,
#removals-content,
#narrow-warning,
#dashboard-issues,
#targets-header,
#targets-status {
    height: auto;
    padding: 1 2;
}

#targets-list {
    height: 1fr;
    min-height: 6;
    padding: 0 1;
}

#action-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 2;
    padding: 1 2;
    height: auto;
}

Button.-disabled-action {
    opacity: 0.45;
}

.setup-target-row {
    padding: 0 2 1 2;
    height: auto;
}

.setup-target-row.-focused {
    background: $surface-lighten-1;
    border: solid $accent;
}

.setup-target-meta {
    padding: 0 0 0 4;
    color: $text-muted;
}

#preview-table {
    height: 1fr;
    padding: 0 2;
}

/* Setup wizard: readable prose width, bottom equal-width actions (80-col friendly). */
.setup-body {
    height: 1fr;
    max-width: 78;
    width: 100%;
    padding: 1 2 0 2;
}

.setup-prose {
    height: auto;
    max-width: 78;
    margin-bottom: 1;
}

.setup-actions {
    dock: bottom;
    height: auto;
    width: 100%;
    max-width: 78;
    padding: 1 2 1 2;
    margin-top: 1;
    layout: vertical;
}

.setup-actions Button {
    width: 36;
    min-width: 36;
    max-width: 36;
    margin: 0 0 1 0;
}

#wordlist-browser {
    height: 12;
    min-height: 8;
    max-width: 78;
    margin: 0 0 1 0;
    border: solid $surface-lighten-2;
}
