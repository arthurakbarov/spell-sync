{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spell-sync.local/schemas/target-validation.json",
  "title": "Spell Sync target validation matrix",
  "type": "object",
  "required": [
    "schema_version",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/targetEntry"
      }
    }
  },
  "$defs": {
    "targetEntry": {
      "type": "object",
      "required": [
        "target_id",
        "platform",
        "implementation",
        "automated_validation",
        "manual_validation",
        "manual_scope",
        "application_version",
        "tested_on",
        "notes",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "implementation": {
          "type": "string",
          "enum": [
            "implemented",
            "experimental",
            "not-implemented"
          ]
        },
        "automated_validation": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "partial",
            "not-run"
          ]
        },
        "manual_validation": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not-run",
            "experimental"
          ]
        },
        "application_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "tested_on": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO date YYYY-MM-DD when set"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ],
          "description": "Repository-relative evidence pointer; no private paths"
        },
        "manual_scope": {
          "type": [
            "string",
            "null"
          ],
          "description": "Depth of manual R-CON evidence when manual_validation is pass; null when not applicable",
          "enum": [
            "read-only",
            "mutation",
            "mutation-ui",
            null
          ]
        }
      }
    }
  }
}
